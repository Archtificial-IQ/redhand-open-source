FROM python:3.12-slim AS build
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY services/redhand-core ./services/redhand-core
COPY packages/redhand-sdk ./packages/redhand-sdk
COPY agentwall ./agentwall
RUN uv sync --frozen --no-dev --package redhand-core --no-install-project

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/services/redhand-core/src \
    PATH=/opt/venv/bin:$PATH
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /opt/venv /opt/venv
COPY services/redhand-core/src /app/services/redhand-core/src
WORKDIR /app
USER app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn redhand_core.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
