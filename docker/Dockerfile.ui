FROM node:22-slim AS build
WORKDIR /app/apps/redhand-ui
ARG NEXT_PUBLIC_REDHAND_CORE_URL=http://localhost:8000
ARG NEXT_PUBLIC_REDHAND_GATEWAY_URL=http://localhost:8080
ENV NEXT_PUBLIC_REDHAND_CORE_URL=$NEXT_PUBLIC_REDHAND_CORE_URL
ENV NEXT_PUBLIC_REDHAND_GATEWAY_URL=$NEXT_PUBLIC_REDHAND_GATEWAY_URL
COPY apps/redhand-ui/package.json apps/redhand-ui/package-lock.json ./
RUN npm ci
COPY apps/redhand-ui/ ./
RUN npm run build

FROM node:22-slim
WORKDIR /app/apps/redhand-ui
ENV NODE_ENV=production
COPY --from=build /app/apps/redhand-ui ./
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
