# ==============================================================================
# RedHand environment configuration (example)
# Copy to .env and replace placeholder values before running outside dev mode.
# In local development mode (ENVIRONMENT=development without SUPABASE_URL),
# redhand-core runs with an in-memory store and needs no external database.
# ==============================================================================

# --- Core control plane (services/redhand-core) ---
# development | test | staging | production
ENVIRONMENT=development
REDHAND_CORE_URL=http://localhost:8000

# Shared secret between redhand-core and AgentWall gateway.
# Must match AGENTWALL_CORE_SERVICE_TOKEN below.
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN_HERE

# Ed25519 private key (PEM, PKCS8) for signing agent access tokens.
# Optional in development (an ephemeral key is generated on startup).
# Generate with: openssl genpkey -algorithm ed25519
AGENT_TOKEN_SIGNING_KEY=
AGENT_TOKEN_TTL_SECONDS=600

# Development only: allow http:// and localhost MCP server URLs.
# Never enable in production.
ALLOW_INSECURE_MCP_URLS=true

# --- AgentWall MCP gateway (agentwall) ---
AGENTWALL_ENVIRONMENT=development
AGENTWALL_CORE_URL=http://localhost:8000
AGENTWALL_CORE_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN_HERE
AGENTWALL_AGENT_TOKEN_PUBLIC_KEY=
AGENTWALL_CONTEXT_CACHE_TTL_SECONDS=2
AGENTWALL_BUDGET_FLUSH_INTERVAL_SECONDS=5
AGENTWALL_BUDGET_MAX_TRACKED_KEYS=100000

# Development only: allow http:// and private-network MCP servers.
# Never enable in production.
AGENTWALL_ALLOW_INSECURE_UPSTREAMS=true

# Append-only JSON-lines copy of gateway decisions.
AGENTWALL_AUDIT_LOG_FILE=./agentwall-audit.jsonl

# --- Optional: PostgreSQL / Supabase persistence ---
# Leave unset to use the in-memory store in development.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
# OPERATOR_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# OPERATOR_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# --- Optional: Local development operator JWT secret (never use in production) ---
# OPERATOR_JWT_SECRET=YOUR_LOCAL_DEV_JWT_SECRET_HERE

# --- Optional: Telegram panic kill-switch bot ---
# TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET_HERE
# TELEGRAM_BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME_HERE

# --- Optional: Slack approval notifications ---
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET_HERE
# SLACK_ORGANIZATION_ID=YOUR_SLACK_ORG_ID_HERE

# --- Optional: Python SDK ---
# REDHAND_API_KEY=YOUR_API_KEY_HERE
# REDHAND_ONNX_MODEL_PATH=~/.cache/redhand/deberta-v3-prompt-injection-int8.onnx
