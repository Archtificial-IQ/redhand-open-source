# RedHand Dashboard (Next.js)
# Note: All NEXT_PUBLIC_* variables are exposed to the browser at build time.
# Never put private secrets here.

NEXT_PUBLIC_REDHAND_CORE_URL=http://localhost:8000
NEXT_PUBLIC_REDHAND_GATEWAY_URL=http://localhost:8080

# Optional: Supabase Auth (leave unset in local development to use the demo login)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Optional: Clerk Auth
# NEXT_PUBLIC_AUTH_PROVIDER=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY_HERE
# NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
